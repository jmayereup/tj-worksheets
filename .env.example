# ------------------------------------------------------------------------------
# PocketBase Configuration
# ------------------------------------------------------------------------------
# The URL of the PocketBase backend instance
# (Defaults to https://pb.teacherjake.com in vite.config.ts / services/pocketbase.ts if omitted during build)
POCKETBASE_URL=https://pb.teacherjake.com

# Base URL for uploaded files/media
# (Defaults to https://files.teacherjake.com in vite.config.ts / services/pocketbase.ts if omitted during build)
FILES_BASE_URL=https://files.teacherjake.com

# PocketBase Admin/Superuser credentials (used for scripts/migrations)
# WARNING: Do not commit actual credentials to version control.
POCKETBASE_ADMIN_EMAIL=your-admin-email@example.com
POCKETBASE_ADMIN_PASSWORD=your-secure-admin-password

# Path to the PocketBase pb_hooks directory
POCKETBASE_HOOKS_PATH=/opt/pocketbase/pb_hooks

# ------------------------------------------------------------------------------
# Deploy (used by `npm run deploy:hook` to push pb_hooks to the server)
# ------------------------------------------------------------------------------
# SSH target for the PocketBase host. Uses your default SSH config /
# ssh-agent (no password prompt) - set DEPLOY_SSH_KEY to override.
DEPLOY_SERVER_IP=your.server.ip
DEPLOY_SERVER_USER=root

# Optional: systemd service name to restart after pushing hooks.
# Defaults to `pocketbase.service`.
# DEPLOY_PB_SERVICE=pocketbase.service

# ------------------------------------------------------------------------------
# Express Server Configuration
# ------------------------------------------------------------------------------
# The port on which the Express server will listen
PORT=3000

# Base path/subpath where the application is served
BASE_PATH=/worksheets

# ------------------------------------------------------------------------------
# Cloudflare Pages
# ------------------------------------------------------------------------------
# Set as an environment variable on the PocketBase server. Used by the
# pb_hooks/worksheets-deploy.pb.js hook to trigger a Cloudflare Pages
# deployment after worksheet changes. Never exposed to the browser bundle.
CLOUDFLARE_DEPLOY_HOOK_URL=https://api.cloudflare.com/client/v4/pages/webhooks/your-deploy-hook-id

# Note: Cloudflare Pages builds use hardcoded default fallbacks in `vite.config.ts`
# (https://pb.teacherjake.com & https://files.teacherjake.com).
# To override these for Cloudflare builds, set POCKETBASE_URL and FILES_BASE_URL
# in the Cloudflare Pages Dashboard -> Settings -> Environment Variables.

# ------------------------------------------------------------------------------
# AI/API Integrations
# ------------------------------------------------------------------------------
# Gemini API key for worksheets and content generation features
GEMINI_API_KEY=your-gemini-api-key-here
